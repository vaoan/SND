## Task Management

### Retainer Task Operations
```lua
-- Start retainer task
function StartRetainerTask(retainerId, taskType, taskId)
    if not HasPlugin("AutoRetainer") then
        return false, "AutoRetainer plugin not available"
    end
    
    local success, result = pcall(function()
        return IPC.AutoRetainer.StartRetainerTask(retainerId, taskType, taskId)
    end)
    
    if success then
        return result, nil
    else
        return false, "Failed to start retainer task: " .. tostring(result)
    end
end

-- Check retainer task status
function GetRetainerTaskStatus(retainerId)
    if not HasPlugin("AutoRetainer") then
        return nil, "AutoRetainer plugin not available"
    end
    
    local success, result = pcall(function()
        return IPC.AutoRetainer.GetRetainerTaskStatus(retainerId)
    end)
    
    if success then
        return result, nil
    else
        return nil, "Failed to get retainer task status: " .. tostring(result)
    end
end
```

## Configuration Integration

### AutoRetainer Configuration Variables
```lua
-- Add to your macro's configs section
configs:
  EnableAutoRetainer:
    default: true
    description: Enable AutoRetainer integration
  RetainerTaskTimeout:
    default: 300
    description: Retainer task timeout in seconds
  MaxRetainerRetries:
    default: 3
    description: Maximum retainer operation retry attempts
```

### Usage in Code
```lua
-- Get configuration values
local enableAutoRetainer = Config.Get("EnableAutoRetainer") == "true"
local retainerTaskTimeout = tonumber(Config.Get("RetainerTaskTimeout"))
local maxRetries = tonumber(Config.Get("MaxRetainerRetries"))

-- Use in AutoRetainer logic
if enableAutoRetainer and HasPlugin("AutoRetainer") then
    local characterData, error = GetAutoRetainerCharacterData()
    if error then
        yield("/echo [Script] ERROR: " .. error)
        return false
    end
end
```

## Best Practices

### 1. Always Use Safe Character ID Access
```lua
-- Always use Svc.ClientState.LocalContentId for character data
local currentCharId = Svc.ClientState.LocalContentId
local characterData = IPC.AutoRetainer.GetOfflineCharacterData(currentCharId)
```

### 2. Use Protected Calls
```lua
-- Use pcall for all AutoRetainer API calls
local success, result = pcall(function()
    return IPC.AutoRetainer.SomeFunction()
end)
```

### 3. Check Plugin Availability
```lua
-- Always check plugin availability before use
if not HasPlugin("AutoRetainer") then
    yield("/echo [Script] AutoRetainer not available")
    return false
end
```

### 4. Handle Errors Gracefully
```lua
-- Handle errors gracefully
local characterData, error = GetAutoRetainerCharacterData()
if error then
    yield("/echo [Script] ERROR: " .. error)
    return false
end
```

### 5. Use Configuration Values
```lua
-- Use configuration values for AutoRetainer settings
local enableAutoRetainer = Config.Get("EnableAutoRetainer") == "true"
if enableAutoRetainer then
    -- AutoRetainer logic
end
```

