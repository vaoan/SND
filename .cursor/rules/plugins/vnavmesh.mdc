## Practical Examples

### Smart Movement with Navmesh Validation
```lua
-- Move to position with navmesh validation
function SmartMoveToPosition(x, y, z, fly)
    fly = fly or false
    
    if not IsVnavmeshReady() then
        yield("/echo [Script] vnavmesh not ready")
        return false
    end
    
    -- Get nearest point on navmesh
    local nearestPoint = GetNearestNavmeshPoint(x, y, z, 2.0, 2.0)
    if nearestPoint then
        yield("/echo [Script] Moving to nearest navmesh point")
        IPC.vnavmesh.PathfindAndMoveTo(nearestPoint, fly)
    else
        yield("/echo [Script] No navmesh point found, trying direct movement")
        IPC.vnavmesh.PathfindAndMoveTo(Vector3(x, y, z), fly)
    end
    
    return true
end

-- Move with waypoint validation
function MoveWithValidatedWaypoints(waypoints, fly)
    fly = fly or false
    
    if not IsVnavmeshReady() then
        yield("/echo [Script] vnavmesh not ready")
        return false
    end
    
    -- Validate each waypoint
    local validWaypoints = {}
    for i, waypoint in ipairs(waypoints) do
        local nearestPoint = GetNearestNavmeshPoint(waypoint.x, waypoint.y, waypoint.z, 1.0, 1.0)
        if nearestPoint then
            table.insert(validWaypoints, nearestPoint)
        else
            yield("/echo [Script] Warning: Waypoint " .. i .. " not on navmesh")
        end
    end
    
    if #validWaypoints > 0 then
        IPC.vnavmesh.MoveTo(validWaypoints, fly)
        return true
    end
    
    yield("/echo [Script] No valid waypoints found")
    return false
end

-- Floor-based movement
function MoveToFloorPosition(x, y, z, fly)
    fly = fly or false
    
    if not IsVnavmeshReady() then
        yield("/echo [Script] vnavmesh not ready")
        return false
    end
    
    -- Get point on floor
    local floorPoint = GetPointOnFloor(x, y, z, false, 1.0)
    if floorPoint then
        yield("/echo [Script] Moving to floor position")
        IPC.vnavmesh.PathfindAndMoveTo(floorPoint, fly)
        return true
    else
        yield("/echo [Script] No floor point found")
        return false
    end
end
```

### Build Progress Monitoring
```lua
-- Monitor vnavmesh build progress
function MonitorVnavmeshBuild()
    if not HasPlugin("vnavmesh") then
        yield("/echo [Script] vnavmesh plugin not available")
        return false
    end
    
    if not IPC.vnavmesh.IsReady() then
        local progress = GetVnavmeshBuildProgress()
        yield("/echo [Script] vnavmesh building... " .. math.floor(progress * 100) .. "%")
        
        -- Wait for build completion
        while not IPC.vnavmesh.IsReady() do
            progress = GetVnavmeshBuildProgress()
            yield("/echo [Script] Build progress: " .. math.floor(progress * 100) .. "%")
            yield("/wait 2")
        end
        
        yield("/echo [Script] vnavmesh build completed")
    end
    
    return true
end
```

## Best Practices

### 1. Always Check Plugin Availability
```lua
-- Check if vnavmesh is available before use
if not HasPlugin("vnavmesh") then
    yield("/echo [Script] vnavmesh not available")
    return false
end
```

### 2. Use Timeouts for Movement
```lua
-- Always use timeouts for movement operations
if not MoveToPositionWithTimeout(x, y, z, 30) then
    yield("/echo [Script] Movement timeout")
    return false
end
```

### 3. Handle Movement States
```lua
-- Check movement state before starting new movement
if IPC.vnavmesh.IsRunning() then
    yield("/echo [Script] vnavmesh is already running, waiting...")
    WaitForVnavmeshStop(30)
end
```

### 4. Verify Arrival
```lua
-- Verify arrival at destination
if not IsAtPosition(x, y, z, 3.0) then
    yield("/echo [Script] WARNING: Not at expected destination")
end
```

### 5. Use Appropriate Wait Times
```lua
-- Use appropriate wait times for movement checking
while IPC.vnavmesh.IsRunning() do
    yield("/wait 1") -- Longer wait for movement
end
```

