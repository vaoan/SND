## Error Handling

### Lifestream Error Handling
```lua
-- Safe Lifestream function call
function SafeLifestreamCall(functionName, ...)
    if not HasPlugin("Lifestream") then
        return nil, "Lifestream plugin not available"
    end
    
    local success, result = pcall(function()
        return IPC.Lifestream[functionName](...)
    end)
    
    if success then
        return result, nil
    else
        return nil, "Lifestream call failed: " .. tostring(result)
    end
end
```

