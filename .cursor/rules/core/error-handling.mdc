# Error Handling Patterns

## Purpose
Defines comprehensive error handling patterns and best practices for SND macros.

## Scope
This rule covers error checking, validation, logging, recovery patterns, and safety measures.

## Basic Error Handling

### Prerequisites Checking
```lua
-- Check plugin availability
if not HasPlugin("RequiredPlugin") then
    yield("/echo [Script] Missing required plugin: RequiredPlugin")
    StopFlag = true
    return
end

-- Check player availability
if not Player.Available then
    yield("/echo [Script] Player not available")
    StopFlag = true
    return
end

-- Check inventory space
if Inventory.GetFreeInventorySlots() <= 0 then
    yield("/echo [Script] No free inventory slots")
    StopFlag = true
    return
end
```

### Safe Function Execution
```lua
-- Safe function execution with error handling
function SafeExecute(func, errorMessage)
    local success, result = pcall(func)
    if success then
        return result, nil
    else
        return nil, errorMessage or tostring(result)
    end
end

-- Usage
local result, error = SafeExecute(function()
    return SomeRiskyOperation()
end, "Operation failed")

if error then
    yield("/echo [Script] ERROR: " .. error)
    return false
end
```

## Plugin Error Handling

### Plugin Availability Check
```lua
-- Check if plugin is available
function HasPlugin(pluginName)
    for plugin in luanet.each(Svc.PluginInterface.InstalledPlugins) do
        if plugin.InternalName == pluginName and plugin.IsLoaded then
            return true
        end
    end
    return false
end

-- Usage
if not HasPlugin("RequiredPlugin") then
    yield("/echo [Script] ERROR: Plugin 'RequiredPlugin' not found!")
    StopFlag = true
end
```

### Safe Plugin Function Calls
```lua
-- Safe plugin function call
function SafePluginCall(pluginName, functionName, ...)
    if not HasPlugin(pluginName) then
        return nil, "Plugin not available: " .. pluginName
    end
    
    local success, result = pcall(function()
        return IPC[pluginName][functionName](...)
    end)
    
    if success then
        return result, nil
    else
        return nil, "Plugin call failed: " .. tostring(result)
    end
end
```

## Addon Error Handling

### Safe Addon Interaction
```lua
-- Safe addon callback with error handling
function SafeAddonCallback(addonName, ...)
    if not IsAddonReady(addonName) then
        yield("/echo [Script] Addon not ready: " .. addonName)
        return false
    end
    
    local success, result = pcall(function()
        return CallbackAddon(addonName, ...)
    end)
    
    if not success then
        yield("/echo [Script] Addon callback failed: " .. tostring(result))
        return false
    end
    
    return result
end
```

### Addon Timeout Handling
```lua
-- Addon operation with timeout
function AddonOperationWithTimeout(addonName, operation, timeout)
    timeout = timeout or 10
    local startTime = os.clock()
    
    while not operation() and (os.clock() - startTime) < timeout do
        yield("/wait 0.1")
    end
    
    if not operation() then
        yield("/echo [Script] Addon operation timeout: " .. addonName)
        return false
    end
    
    return true
end
```

## Configuration Error Handling

### Configuration Validation
```lua
-- Validate configuration values
function ValidateConfig(key, expectedType, required)
    local value = Config.Get(key)
    
    if required and not value then
        return false, "Required configuration missing: " .. key
    end
    
    if value and expectedType == "number" and not tonumber(value) then
        return false, "Invalid number configuration: " .. key
    end
    
    if value and expectedType == "boolean" and value ~= "true" and value ~= "false" then
        return false, "Invalid boolean configuration: " .. key
    end
    
    return true, nil
end
```

### Safe Configuration Access
```lua
-- Safe configuration access with validation
function GetConfigSafely(key, expectedType, defaultValue)
    local value = Config.Get(key)
    
    if not value then
        if defaultValue then
            return defaultValue
        else
            yield("/echo [Script] ERROR: Missing required configuration: " .. key)
            StopFlag = true
            return nil
        end
    end
    
    if expectedType == "number" then
        local numValue = tonumber(value)
        if not numValue then
            yield("/echo [Script] ERROR: Invalid number configuration: " .. key)
            StopFlag = true
            return nil
        end
        return numValue
    elseif expectedType == "boolean" then
        return value == "true"
    end
    
    return value
end
```

## Timeout and Retry Patterns

### Retry with Backoff
```lua
-- Retry function with exponential backoff
function RetryWithBackoff(func, maxRetries, baseDelay)
    maxRetries = maxRetries or 3
    baseDelay = baseDelay or 1
    
    for attempt = 1, maxRetries do
        local success, result = pcall(func)
        if success then
            return result, nil
        end
        
        if attempt < maxRetries then
            local delay = baseDelay * (2 ^ (attempt - 1))
            yield("/echo [Script] Attempt " .. attempt .. " failed, retrying in " .. delay .. " seconds")
            yield("/wait " .. delay)
        end
    end
    
    return nil, "Function failed after " .. maxRetries .. " attempts"
end
```

### Timeout Handling
```lua
-- Wait with timeout
function WaitWithTimeout(condition, timeout, interval)
    timeout = timeout or 30
    interval = interval or 0.1
    local startTime = os.clock()
    
    while not condition() and (os.clock() - startTime) < timeout do
        yield("/wait " .. interval)
    end
    
    if not condition() then
        yield("/echo [Script] Operation timed out after " .. timeout .. " seconds")
        return false
    end
    
    return true
end
```

## State Machine Error Handling

### Error State Pattern
```lua
CharacterState = {
    ready = Ready,
    working = Working,
    error = Error,
    recovery = Recovery
}

function Error()
    yield("/echo [Script] ERROR: " .. errorMessage)
    -- Log error details
    -- Attempt recovery
    State = CharacterState.recovery
end

function Recovery()
    -- Attempt to recover from error
    if recoverySuccessful then
        State = CharacterState.ready
    else
        yield("/echo [Script] Recovery failed, stopping")
        StopFlag = true
    end
end
```

### State Timeout Handling
```lua
-- Add timeout to state machine
local stateStartTime = os.clock()
local stateTimeout = 30 -- seconds

function Working()
    -- Check for timeout
    if (os.clock() - stateStartTime) > stateTimeout then
        yield("/echo [Script] State timeout, moving to error")
        State = CharacterState.error
        return
    end
    
    -- Normal state logic
    if workComplete then
        State = CharacterState.ready
        stateStartTime = os.clock() -- Reset timer
    end
end
```

## Logging and Error Messages

### Standardized Error Logging
```lua
-- Standardized error logging
function LogError(scriptName, message)
    yield("/echo [" .. scriptName .. "] ERROR: " .. message)
end

function LogWarning(scriptName, message)
    yield("/echo [" .. scriptName .. "] WARNING: " .. message)
end

function LogInfo(scriptName, message)
    yield("/echo [" .. scriptName .. "] INFO: " .. message)
end
```

### Error Message Format
```lua
-- Use consistent error message format
yield("/echo [ScriptName] ERROR: Description")
yield("/echo [ScriptName] WARNING: Description")
yield("/echo [ScriptName] INFO: Description")
```

## Common Error Scenarios

### Plugin Not Available
```lua
-- Handle plugin not available
if not HasPlugin("RequiredPlugin") then
    yield("/echo [Script] ERROR: Plugin 'RequiredPlugin' not found!")
    yield("/echo [Script] Please install and enable the required plugin")
    StopFlag = true
    return
end
```

### Player Not Available
```lua
-- Handle player not available
if not Player.Available then
    yield("/echo [Script] ERROR: Player not available!")
    yield("/wait 1")
    return
end
```

### Addon Not Ready
```lua
-- Handle addon not ready with timeout
local timeout = 10
local startTime = os.clock()
while not Addons.GetAddon("AddonName").Ready and (os.clock() - startTime) < timeout do
    yield("/wait 0.1")
end

if not Addons.GetAddon("AddonName").Ready then
    yield("/echo [Script] ERROR: Addon 'AddonName' not ready after timeout!")
    StopFlag = true
end
```

### Movement Issues
```lua
-- Handle movement timeout
local startTime = os.clock()
while IPC.vnavmesh.IsRunning() and (os.clock() - startTime) < 30 do
    yield("/wait 1")
end

if IPC.vnavmesh.IsRunning() then
    yield("/echo [Script] WARNING: Movement taking too long, stopping...")
    IPC.vnavmesh.Stop()
end
```

### Inventory Issues
```lua
-- Handle inventory space issues
if Inventory.GetFreeInventorySlots() <= 0 then
    yield("/echo [Script] ERROR: No free inventory slots!")
    yield("/echo [Script] Please free up inventory space and try again")
    StopFlag = true
end
```

## Best Practices

### 1. Always Check Prerequisites
```lua
-- Check all prerequisites before starting
if not HasPlugin("RequiredPlugin") then
    yield("/echo [Script] Missing required plugin")
    StopFlag = true
    return
end

if not Player.Available then
    yield("/echo [Script] Player not available")
    StopFlag = true
    return
end
```

### 2. Use Safe Function Calls
```lua
-- Use pcall for potentially failing operations
local success, result = pcall(function()
    return SomeRiskyOperation()
end)

if not success then
    yield("/echo [Script] Operation failed: " .. tostring(result))
    return false
end
```

### 3. Implement Timeouts
```lua
-- Always use timeouts for waiting operations
if not WaitWithTimeout(condition, 30) then
    yield("/echo [Script] Operation timed out")
    return false
end
```

### 4. Provide Clear Error Messages
```lua
-- Provide actionable error messages
yield("/echo [Script] ERROR: Plugin 'RequiredPlugin' not found!")
yield("/echo [Script] Please install and enable the required plugin")
```

### 5. Handle Edge Cases
```lua
-- Consider what happens in unusual situations
if not someCondition then
    yield("/echo [Script] WARNING: Unexpected condition, attempting recovery")
    -- Attempt recovery
end
```

