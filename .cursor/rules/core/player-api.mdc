## Job and Gearset Integration

### Job Information
```lua
-- Get current job information
function GetCurrentJob()
    if not Player.Available then
        return nil
    end
    
    return Player.Job
end

-- Get job by ID
function GetJobById(jobId)
    if not Player.Available then
        return nil
    end
    
    return Player.GetJob(jobId)
end

-- Check if player is specific job
function IsJob(jobId)
    local job = GetCurrentJob()
    if not job then
        return false
    end
    
    return job.ClassJobId == jobId
end

-- Get job level
function GetJobLevel()
    local job = GetCurrentJob()
    if not job then
        return nil
    end
    
    return job.Level
end

-- Check if job is max level
function IsJobMaxLevel()
    local level = GetJobLevel()
    if not level then
        return false
    end
    
    return level >= 90 -- Adjust based on current max level
end
```

