## Practical Examples

### Player State Monitoring
```lua
-- Monitor player state
function MonitorPlayerState()
    if not Player.Available then
        yield("/echo [Script] Player not available")
        return false
    end
    
    local state = {
        available = Player.Available,
        busy = Player.IsBusy,
        moving = Player.IsMoving,
        inDuty = Player.IsInDuty,
        onIsland = Player.IsOnIsland,
        levelSynced = Player.IsLevelSynced,
        syncedLevel = Player.SyncedLevel,
        canMount = Player.CanMount,
        canFly = Player.CanFly,
        revivable = Player.Revivable
    }
    
    yield("/echo [Script] Player State: " .. json.encode(state))
    return true
end
```

### Target Information Display
```lua
-- Display target information
function DisplayTargetInfo()
    local target = GetPlayerTarget()
    if not target then
        yield("/echo [Script] No target selected")
        return
    end
    
    local info = {
        name = target.Name,
        level = target.Level,
        maxHp = target.MaxHp,
        maxMp = target.MaxMp,
        currentHp = target.CurrentHp,
        currentMp = target.CurrentMp
    }
    
    yield("/echo [Script] Target: " .. info.name .. " (Lv." .. info.level .. ")")
    yield("/echo [Script] HP: " .. info.currentHp .. "/" .. info.maxHp)
    yield("/echo [Script] MP: " .. info.currentMp .. "/" .. info.maxMp)
end
```

### Job-Specific Actions
```lua
-- Check if player can craft
function CanCraft()
    local job = GetCurrentJob()
    if not job then
        return false
    end
    
    -- Check if job is a crafting job (IDs 8-15)
    return job.ClassJobId >= 8 and job.ClassJobId <= 15
end

-- Check if player can gather
function CanGather()
    local job = GetCurrentJob()
    if not job then
        return false
    end
    
    -- Check if job is a gathering job (IDs 16-18)
    return job.ClassJobId >= 16 and job.ClassJobId <= 18
end

-- Check if player can fish
function CanFish()
    local job = GetCurrentJob()
    if not job then
        return false
    end
    
    -- Check if job is Fisher (ID 18)
    return job.ClassJobId == 18
end
```

## Error Handling

### Safe Player API Access
```lua
-- Safe player API access
function SafePlayerAccess(func, errorMessage)
    if not Player.Available then
        yield("/echo [Script] ERROR: Player not available")
        return nil, "Player not available"
    end
    
    local success, result = pcall(func)
    if success then
        return result, nil
    else
        yield("/echo [Script] ERROR: " .. (errorMessage or tostring(result)))
        return nil, errorMessage or tostring(result)
    end
end

-- Usage example
local target, error = SafePlayerAccess(function()
    return Player.Entity.Target
end, "Failed to get target")

if error then
    yield("/echo [Script] Target access failed: " .. error)
elseif target then
    yield("/echo [Script] Target: " .. target.Name)
end
```

### Player State Validation
```lua
-- Validate player state before actions
function ValidatePlayerState()
    if not Player.Available then
        yield("/echo [Script] ERROR: Player not available")
        return false
    end
    
    if Player.IsBusy then
        yield("/echo [Script] ERROR: Player is busy")
        return false
    end
    
    if Player.IsMoving then
        yield("/echo [Script] ERROR: Player is moving")
        return false
    end
    
    if Player.IsInDuty then
        yield("/echo [Script] WARNING: Player is in duty")
        -- Don't return false, just warn
    end
    
    return true
end
```

## Configuration Integration

### Player API Configuration
```lua
-- Add to your macro's configs section
configs:
  EnablePlayerAPI:
    default: true
    description: Enable Player API integration
  PlayerStateCheckInterval:
    default: 1.0
    description: Player state check interval in seconds
  MaxPlayerWaitTime:
    default: 30
    description: Maximum time to wait for player availability
```

### Usage in Code
```lua
-- Get configuration values
local enablePlayerAPI = Config.Get("EnablePlayerAPI") == "true"
local checkInterval = tonumber(Config.Get("PlayerStateCheckInterval"))
local maxWaitTime = tonumber(Config.Get("MaxPlayerWaitTime"))

-- Use in player logic
if enablePlayerAPI then
    if not WaitForPlayerAvailable(maxWaitTime) then
        yield("/echo [Script] Player not available after timeout")
        return false
    end
end
```

## Best Practices

### 1. Always Check Player Availability
```lua
-- Check if player is available before use
if not Player.Available then
    yield("/echo [Script] Player not available")
    return false
end
```

### 2. Use Safe Access Patterns
```lua
-- Use safe access for nested properties
local target = Player.Available and Player.Entity and Player.Entity.Target
if target then
    -- Use target safely
end
```

### 3. Handle Player State Changes
```lua
-- Monitor player state changes
if Player.IsBusy then
    yield("/echo [Script] Player is busy, waiting...")
    while Player.IsBusy do
        yield("/wait 0.1")
    end
end
```

### 4. Validate Before Actions
```lua
-- Validate player state before actions
if not ValidatePlayerState() then
    yield("/echo [Script] Player state validation failed")
    return false
end
```

### 5. Use Appropriate Wait Times
```lua
-- Use appropriate wait times for player state checking
while Player.IsMoving do
    yield("/wait 0.1") -- Quick check for movement
end

while Player.IsBusy do
    yield("/wait 1") -- Longer wait for busy state
end
```

