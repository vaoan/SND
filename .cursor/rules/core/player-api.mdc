## Status Integration

### Status Checking
```lua
-- Get player status effects
function GetPlayerStatus()
    if not Player.Available then
        return nil
    end
    
    return Player.Status
end

-- Check if player has specific status
function HasStatus(statusId)
    local status = GetPlayerStatus()
    if not status then
        return false
    end
    
    for _, statusEffect in ipairs(status) do
        if statusEffect.StatusId == statusId then
            return true
        end
    end
    
    return false
end

-- Get status effect by ID
function GetStatusById(statusId)
    local status = GetPlayerStatus()
    if not status then
        return nil
    end
    
    for _, statusEffect in ipairs(status) do
        if statusEffect.StatusId == statusId then
            return statusEffect
        end
    end
    
    return nil
end

-- Get status remaining time
function GetStatusRemainingTime(statusId)
    local statusEffect = GetStatusById(statusId)
    if not statusEffect then
        return 0
    end
    
    return statusEffect.RemainingTime
end
```

## Grand Company Integration

### Grand Company Information
```lua
-- Get grand company
function GetGrandCompany()
    if not Player.Available then
        return nil
    end
    
    return Player.GrandCompany
end

-- Get grand company rank
function GetGrandCompanyRank(gcType)
    if not Player.Available then
        return nil
    end
    
    if gcType == "Maelstrom" then
        return Player.GCRankMaelstrom
    elseif gcType == "ImmortalFlames" then
        return Player.GCRankImmortalFlames
    elseif gcType == "TwinAdders" then
        return Player.GCRankTwinAdders
    end
    
    return nil
end

-- Set grand company rank
function SetGrandCompanyRank(gcType, rank)
    if not Player.Available then
        return false
    end
    
    if gcType == "Maelstrom" then
        Player.GCRankMaelstrom = rank
        return true
    elseif gcType == "ImmortalFlames" then
        Player.GCRankImmortalFlames = rank
        return true
    elseif gcType == "TwinAdders" then
        Player.GCRankTwinAdders = rank
        return true
    end
    
    return false
end
```

