## Condition Monitoring

### Monitor All Conditions
```lua
-- Monitor all character conditions
function MonitorCharacterConditions()
    local conditions = {
        {id = CharacterCondition.craftingMode, name = "Crafting Mode"},
        {id = CharacterCondition.casting, name = "Casting"},
        {id = CharacterCondition.betweenAreas, name = "Between Areas"},
        {id = CharacterCondition.beingMoved, name = "Being Moved"},
        {id = CharacterCondition.occupiedInQuestEvent, name = "Quest Event"},
        {id = CharacterCondition.occupiedMateriaExtractionAndRepair, name = "Materia/Repair"},
        {id = CharacterCondition.occupiedSummoningBell, name = "Summoning Bell"}
    }
    
    for _, condition in ipairs(conditions) do
        if Svc.Condition[condition.id] then
            yield("/echo [Script] " .. condition.name .. " is active")
        end
    end
end
```

### Log Active Conditions
```lua
-- Log currently active conditions
function LogActiveConditions()
    local activeConditions = {}
    
    if Svc.Condition[CharacterCondition.craftingMode] then
        table.insert(activeConditions, "Crafting Mode")
    end
    if Svc.Condition[CharacterCondition.casting] then
        table.insert(activeConditions, "Casting")
    end
    if Svc.Condition[CharacterCondition.betweenAreas] then
        table.insert(activeConditions, "Between Areas")
    end
    if Svc.Condition[CharacterCondition.beingMoved] then
        table.insert(activeConditions, "Being Moved")
    end
    
    if #activeConditions > 0 then
        yield("/echo [Script] Active conditions: " .. table.concat(activeConditions, ", "))
    end
end
```

## Best Practices

### 1. Always Check Conditions Before Actions
```lua
-- Good - check conditions before proceeding
if not IsCharacterBusy() then
    -- Perform action
    State()
end

-- Bad - don't check conditions
State() -- May fail if character is busy
```

### 2. Use Appropriate Wait Times
```lua
-- Good - use appropriate wait times for condition checking
while Svc.Condition[CharacterCondition.casting] do
    yield("/wait 0.1") -- Quick check for casting
end

while Svc.Condition[CharacterCondition.betweenAreas] do
    yield("/wait 1") -- Longer wait for teleporting
end
```

### 3. Handle Timeouts
```lua
-- Good - use timeouts for condition waiting
local startTime = os.clock()
while Svc.Condition[CharacterCondition.casting] and (os.clock() - startTime) < 10 do
    yield("/wait 0.1")
end
```

### 4. Combine with Plugin States
```lua
-- Good - check both character conditions and plugin states
function IsCharacterBusy()
    return Svc.Condition[CharacterCondition.casting] or
           Svc.Condition[CharacterCondition.betweenAreas] or
           IPC.Lifestream.IsBusy() or
           Player.IsBusy
end
```

