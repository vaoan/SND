## Error Handling in State Machines

### Error State Pattern
```lua
CharacterState = {
    ready = Ready,
    working = Working,
    error = Error,
    recovery = Recovery
}

function Error()
    yield("/echo [Script] ERROR: " .. errorMessage)
    -- Log error details
    -- Attempt recovery
    State = CharacterState.recovery
end

function Recovery()
    -- Attempt to recover from error
    if recoverySuccessful then
        State = CharacterState.ready
    else
        yield("/echo [Script] Recovery failed, stopping")
        StopFlag = true
    end
end
```

### Timeout Handling
```lua
-- Add timeout to state machine
local stateStartTime = os.clock()
local stateTimeout = 30 -- seconds

function Working()
    -- Check for timeout
    if (os.clock() - stateStartTime) > stateTimeout then
        yield("/echo [Script] State timeout, moving to error")
        State = CharacterState.error
        return
    end
    
    -- Normal state logic
    if workComplete then
        State = CharacterState.ready
        stateStartTime = os.clock() -- Reset timer
    end
end
```

## Best Practices

### 1. Use Descriptive State Names
```lua
-- Good
CharacterState = {
    ready = Ready,
    crafting = Crafting,
    managingInventory = ManagingInventory
}

-- Bad
CharacterState = {
    s1 = State1,
    s2 = State2,
    s3 = State3
}
```

### 2. Keep States Focused
```lua
-- Good - single responsibility
function Crafting()
    -- Only handle crafting logic
    if craftingComplete then
        State = CharacterState.ready
    end
end

-- Bad - multiple responsibilities
function Crafting()
    -- Handle crafting
    -- Handle inventory
    -- Handle movement
    -- Handle UI
end
```

### 3. Handle All State Transitions
```lua
-- Good - explicit transitions
function Ready()
    if condition1 then
        State = CharacterState.state1
    elseif condition2 then
        State = CharacterState.state2
    else
        State = CharacterState.waiting
    end
end
```

### 4. Use Stop Conditions
```lua
-- Always include stop conditions
while not StopFlag do
    if not Player.IsBusy then
        State()
    end
    yield("/wait 0.1")
end
```

### 5. Log State Transitions
```lua
-- Log important state transitions
function Ready()
    yield("/echo [Script] Entering Ready state")
    -- State logic
    if someCondition then
        yield("/echo [Script] Transitioning to Working state")
        State = CharacterState.working
    end
end
```

