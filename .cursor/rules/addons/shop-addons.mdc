## Advanced Shop Addon Patterns

### Shop Addon State Management
```lua
-- Check shop addon states
function GetShopAddonStatus()
    local status = {
        collectablesShop = IsCollectablesShopReady(),
        inclusionShop = IsInclusionShopReady()
    }
    return status
end

-- Wait for shop addon to be ready
function WaitForShopAddonReady(addonName, timeout)
    timeout = timeout or 10
    local startTime = os.clock()
    
    while not Addons.GetAddon(addonName).Ready and (os.clock() - startTime) < timeout do
        yield("/wait 0.1")
    end
    
    return Addons.GetAddon(addonName).Ready
end
```

### Shop Addon Error Handling
```lua
-- Safe shop addon callback
function SafeShopAddonCallback(addonName, functionName, ...)
    if not Addons.GetAddon(addonName).Ready then
        yield("/echo [Script] Addon not ready: " .. addonName)
        return false
    end
    
    local success, result = pcall(function()
        return CallbackAddon(addonName, functionName, ...)
    end)
    
    if not success then
        yield("/echo [Script] Addon callback failed: " .. tostring(result))
        return false
    end
    
    return result
end
```

## Shop Workflow Integration

### Complete Shop Workflow
```lua
-- Complete shop workflow with addon integration
function CompleteShopWorkflow(shopType, itemId, quantity, timeout)
    timeout = timeout or 60
    
    -- Check prerequisites
    if shopType == "collectables" and not IsCollectablesShopReady() then
        yield("/echo [Script] ERROR: CollectablesShop addon not ready")
        return false
    end
    
    if shopType == "inclusion" and not IsInclusionShopReady() then
        yield("/echo [Script] ERROR: InclusionShop addon not ready")
        return false
    end
    
    -- Open appropriate shop
    if shopType == "collectables" then
        if not OpenCollectablesShop() then
            yield("/echo [Script] ERROR: Failed to open CollectablesShop")
            return false
        end
    elseif shopType == "inclusion" then
        if not OpenInclusionShop() then
            yield("/echo [Script] ERROR: Failed to open InclusionShop")
            return false
        end
    end
    
    -- Wait for shop to open
    yield("/wait 1")
    
    -- Perform shop operations
    -- This would need to be implemented based on specific shop addon APIs
    yield("/echo [Script] Shop operations completed")
    
    -- Close shop
    if shopType == "collectables" then
        CloseCollectablesShop()
    elseif shopType == "inclusion" then
        CloseInclusionShop()
    end
    
    yield("/echo [Script] Shop workflow completed successfully")
    return true
end
```

## State Machine Integration

### Shop State Pattern
```lua
-- Add shop state to your state machine
CharacterState = {
    ready = Ready,
    openingShop = OpeningShop,
    shopping = Shopping,
    -- ... other states
}

function OpeningShop()
    if OpenCollectablesShop() then
        yield("/echo [Script] Shop opened")
        State = CharacterState.shopping
    else
        yield("/echo [Script] Failed to open shop")
        State = CharacterState.ready
    end
end

function Shopping()
    if CompleteShopWorkflow("collectables", itemId, quantity, 60) then
        yield("/echo [Script] Shopping completed")
        State = CharacterState.ready
    else
        yield("/echo [Script] Shopping failed")
        State = CharacterState.ready
    end
end
```

## Configuration Integration

### Shop Addon Configuration Variables
```lua
-- Add to your macro's configs section
configs:
  EnableShopAddons:
    default: true
    description: Enable shop addon interactions
  ShopTimeout:
    default: 60
    description: Shop timeout in seconds
  AddonWaitTimeout:
    default: 10
    description: Addon wait timeout in seconds
```

### Usage in Code
```lua
-- Get configuration values
local enableShopAddons = Config.Get("EnableShopAddons") == "true"
local shopTimeout = tonumber(Config.Get("ShopTimeout"))
local addonWaitTimeout = tonumber(Config.Get("AddonWaitTimeout"))

-- Use in shop logic
if enableShopAddons then
    if not CompleteShopWorkflow("collectables", itemId, quantity, shopTimeout) then
        yield("/echo [Script] Shopping failed")
        return false
    end
end
```

## Best Practices

### 1. Always Check Addon Readiness
```lua
-- Check addon readiness before use
if not IsCollectablesShopReady() then
    yield("/echo [Script] CollectablesShop not ready")
    return false
end
```

### 2. Use Timeouts for Addon Operations
```lua
-- Use timeouts for addon operations
if not WaitForShopAddonReady("CollectablesShop", 10) then
    yield("/echo [Script] CollectablesShop timeout")
    return false
end
```

### 3. Handle Addon Errors
```lua
-- Handle addon errors gracefully
if not SafeShopAddonCallback("CollectablesShop", "OpenCollectablesShop") then
    yield("/echo [Script] Failed to open CollectablesShop")
    return false
end
```

### 4. Use Appropriate Wait Times
```lua
-- Use appropriate wait times for addon operations
yield("/wait 1") -- Wait for addon to respond
```

### 5. Monitor Addon States
```lua
-- Monitor addon states
local status = GetShopAddonStatus()
if status.collectablesShop and status.inclusionShop then
    yield("/echo [Script] All shop addons ready")
end
```

