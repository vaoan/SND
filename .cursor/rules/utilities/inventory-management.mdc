# Inventory Management

## Purpose
Utility functions for inventory management and item handling in SND macros.

## Scope
This rule covers inventory checking, item management, and inventory space utilities.

## Basic Inventory Functions

### Inventory Space Checking
```lua
-- Get free inventory slots
function GetFreeInventorySlots()
    return Inventory.GetFreeInventorySlots()
end

-- Check if inventory has space
function HasInventorySpace(requiredSlots)
    requiredSlots = requiredSlots or 1
    return Inventory.GetFreeInventorySlots() >= requiredSlots
end

-- Check if inventory is full
function IsInventoryFull()
    return Inventory.GetFreeInventorySlots() <= 0
end
```

### Item Count Functions
```lua
-- Get item count by ID
function GetItemCount(itemId)
    return Inventory.GetItemCount(itemId)
end

-- Get item count by name
function GetItemCountByName(itemName)
    local itemData = Svc.DataManager.GetExcelSheet(ExcelSheet.Item)
    for _, item in ipairs(itemData) do
        if item.Name == itemName then
            return Inventory.GetItemCount(item.RowId)
        end
    end
    return 0
end

-- Check if has item
function HasItem(itemId, requiredCount)
    requiredCount = requiredCount or 1
    return Inventory.GetItemCount(itemId) >= requiredCount
end
```

## Advanced Inventory Functions

### Find Item in Inventory
```lua
-- Find item in inventory by ID
function FindItemInInventory(itemId)
    for slot = 1, Inventory.GetMaxInventorySlots() do
        local item = Inventory.GetItem(slot)
        if item and item.ItemId == itemId then
            return item, slot
        end
    end
    return nil, nil
end

-- Find item in inventory by name
function FindItemInInventoryByName(itemName)
    local itemData = Svc.DataManager.GetExcelSheet(ExcelSheet.Item)
    for _, item in ipairs(itemData) do
        if item.Name == itemName then
            return FindItemInInventory(item.RowId)
        end
    end
    return nil, nil
end
```

### Inventory Management
```lua
-- Sort inventory
function SortInventory()
    if HasPlugin("InventorySorter") then
        IPC.InventorySorter.SortInventory()
    else
        yield("/echo [Script] InventorySorter plugin not available")
    end
end

-- Discard item
function DiscardItem(itemId, quantity)
    quantity = quantity or 1
    local item, slot = FindItemInInventory(itemId)
    if item and slot then
        Inventory.DiscardItem(slot, quantity)
        return true
    end
    return false
end
```

## Item Category Functions

### Get Items by Category
```lua
-- Get items by category
function GetItemsByCategory(categoryId)
    local items = {}
    for slot = 1, Inventory.GetMaxInventorySlots() do
        local item = Inventory.GetItem(slot)
        if item and item.CategoryId == categoryId then
            table.insert(items, item)
        end
    end
    return items
end
```

