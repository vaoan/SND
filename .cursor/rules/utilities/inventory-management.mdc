## Inventory Validation

### Validate Inventory Space
```lua
-- Validate inventory space
function ValidateInventorySpace(requiredSlots, operation)
    requiredSlots = requiredSlots or 1
    operation = operation or "operation"
    
    if not HasInventorySpace(requiredSlots) then
        yield("/echo [Script] ERROR: Not enough inventory space for " .. operation)
        yield("/echo [Script] Required: " .. requiredSlots .. " slots, Available: " .. GetFreeInventorySlots())
        return false
    end
    
    return true
end
```

### Check Inventory Prerequisites
```lua
-- Check inventory prerequisites
function CheckInventoryPrerequisites(requiredItems, requiredSlots)
    requiredItems = requiredItems or {}
    requiredSlots = requiredSlots or 0
    
    -- Check required items
    for _, item in ipairs(requiredItems) do
        if not HasItem(item.id, item.count) then
            yield("/echo [Script] ERROR: Missing required item: " .. item.name)
            return false
        end
    end
    
    -- Check inventory space
    if not ValidateInventorySpace(requiredSlots, "operation") then
        return false
    end
    
    return true
end
```

## Inventory Monitoring

### Monitor Inventory Changes
```lua
-- Monitor inventory changes
function MonitorInventoryChanges(callback, timeout)
    timeout = timeout or 30
    local startTime = os.clock()
    local initialSlots = GetFreeInventorySlots()
    
    while (os.clock() - startTime) < timeout do
        local currentSlots = GetFreeInventorySlots()
        if currentSlots ~= initialSlots then
            callback(currentSlots, initialSlots)
            return true
        end
        yield("/wait 0.1")
    end
    
    return false
end
```

### Log Inventory Status
```lua
-- Log inventory status
function LogInventoryStatus()
    local freeSlots = GetFreeInventorySlots()
    local totalSlots = Inventory.GetMaxInventorySlots()
    local usedSlots = totalSlots - freeSlots
    
    yield("/echo [Script] Inventory Status:")
    yield("/echo [Script] Free slots: " .. freeSlots)
    yield("/echo [Script] Used slots: " .. usedSlots)
    yield("/echo [Script] Total slots: " .. totalSlots)
end
```

## Item Management Patterns

### Item Collection Pattern
```lua
-- Item collection pattern
function CollectItems(itemIds, maxQuantity)
    maxQuantity = maxQuantity or 999
    local collectedItems = {}
    
    for _, itemId in ipairs(itemIds) do
        local count = GetItemCount(itemId)
        if count > 0 then
            collectedItems[itemId] = count
        end
    end
    
    return collectedItems
end
```

### Item Usage Pattern
```lua
-- Item usage pattern
function UseItem(itemId, quantity)
    quantity = quantity or 1
    
    if not HasItem(itemId, quantity) then
        yield("/echo [Script] ERROR: Not enough items to use")
        return false
    end
    
    -- Use item logic here
    yield("/echo [Script] Using item: " .. itemId .. " x" .. quantity)
    return true
end
```

## Configuration Integration

### Inventory Configuration Variables
```lua
-- Add to your macro's configs section
configs:
  MinInventorySlots:
    default: 5
    description: Minimum free inventory slots required
  MaxInventorySlots:
    default: 100
    description: Maximum inventory slots to use
  EnableInventorySorting:
    default: true
    description: Enable automatic inventory sorting
```

### Usage in Code
```lua
-- Get configuration values
local minInventorySlots = tonumber(Config.Get("MinInventorySlots"))
local maxInventorySlots = tonumber(Config.Get("MaxInventorySlots"))
local enableSorting = Config.Get("EnableInventorySorting") == "true"

-- Use in inventory logic
if not ValidateInventorySpace(minInventorySlots, "operation") then
    return false
end

if enableSorting and GetFreeInventorySlots() < minInventorySlots then
    SortInventory()
end
```

## Best Practices

### 1. Always Check Inventory Space
```lua
-- Check inventory space before operations
if not ValidateInventorySpace(requiredSlots, "operation") then
    return false
end
```

### 2. Use Appropriate Item Checks
```lua
-- Use appropriate item checks
if HasItem(itemId, requiredCount) then
    -- Use item
else
    yield("/echo [Script] Missing required item")
end
```

### 3. Handle Inventory Changes
```lua
-- Monitor inventory changes when needed
MonitorInventoryChanges(function(current, initial)
    yield("/echo [Script] Inventory changed: " .. (initial - current) .. " slots used")
end)
```

### 4. Use Configuration Values
```lua
-- Use configuration values for inventory thresholds
local minSlots = tonumber(Config.Get("MinInventorySlots")) or 5
if GetFreeInventorySlots() < minSlots then
    yield("/echo [Script] Low inventory space")
end
```

### 5. Log Inventory Status
```lua
-- Log inventory status for debugging
LogInventoryStatus()
```

