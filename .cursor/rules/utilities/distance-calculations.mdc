## Best Practices

### 1. Use Appropriate Tolerances
```lua
-- Use appropriate tolerances for different operations
local movementTolerance = 3.0  -- For movement
local interactionTolerance = 2.0  -- For interactions
local precisionTolerance = 0.5  -- For precise positioning
```

### 2. Check for Valid Entities
```lua
-- Always check for valid entities before distance calculations
if entity and entity.Position then
    local distance = GetDistanceToEntity(entity)
    -- Use distance
end
```

### 3. Use Efficient Distance Checks
```lua
-- Use squared distance for comparisons when possible
function IsWithinRangeSquared(targetX, targetY, targetZ, maxDistanceSquared)
    local playerPos = Player.Position
    local dx = targetX - playerPos.X
    local dy = targetY - playerPos.Y
    local dz = targetZ - playerPos.Z
    local distanceSquared = dx * dx + dy * dy + dz * dz
    return distanceSquared <= maxDistanceSquared
end
```

### 4. Handle Edge Cases
```lua
-- Handle edge cases in distance calculations
function SafeDistanceToEntity(entity)
    if not entity or not entity.Position then
        return math.huge
    end
    
    if not Player.Available or not Player.Position then
        return math.huge
    end
    
    return GetDistanceToEntity(entity)
end
```

### 5. Use Configuration Values
```lua
-- Use configuration values for distance thresholds
local tolerance = tonumber(Config.Get("MovementTolerance")) or 3.0
if IsAtPosition(x, y, z, tolerance) then
    -- Handle position reached
end
```

