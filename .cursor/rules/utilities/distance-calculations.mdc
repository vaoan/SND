## Zone and Location Functions

### Distance to Zone Center
```lua
-- Calculate distance to zone center
function GetDistanceToZoneCenter()
    local zoneData = Svc.DataManager.GetExcelSheet(ExcelSheet.Zone)
    local currentZone = Svc.ClientState.TerritoryType
    local zone = zoneData.GetRow(currentZone)
    
    if not zone then
        return math.huge
    end
    
    return GetDistanceToPoint(zone.X, zone.Y, zone.Z)
end
```

### Distance to Aetheryte
```lua
-- Calculate distance to nearest aetheryte
function GetDistanceToNearestAetheryte(maxDistance)
    maxDistance = maxDistance or 100.0
    local nearestDistance = math.huge
    local nearestAetheryte = nil
    
    for entity in EntityList.GetEntities() do
        if entity.Type == EntityType.Aetheryte then
            local distance = GetDistanceToEntity(entity)
            if distance < nearestDistance and distance <= maxDistance then
                nearestDistance = distance
                nearestAetheryte = entity
            end
        end
    end
    
    return nearestDistance, nearestAetheryte
end
```

## Utility Functions

### Format Distance
```lua
-- Format distance for display
function FormatDistance(distance)
    if distance >= 1000 then
        return string.format("%.1fkm", distance / 1000)
    else
        return string.format("%.1fm", distance)
    end
end
```

### Distance Comparison
```lua
-- Compare distances with tolerance
function IsDistanceEqual(distance1, distance2, tolerance)
    tolerance = tolerance or 0.1
    return math.abs(distance1 - distance2) <= tolerance
end
```

### Clamp Distance
```lua
-- Clamp distance to range
function ClampDistance(distance, minDistance, maxDistance)
    return math.max(minDistance, math.min(maxDistance, distance))
end
```

