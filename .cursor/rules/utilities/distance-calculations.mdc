# Distance Calculations

## Purpose
Utility functions for distance calculations and position checking in SND macros.

## Scope
This rule covers distance calculation functions, position checking, and coordinate utilities.

## Basic Distance Functions

### Distance to Point
```lua
-- Calculate distance to a specific point
function GetDistanceToPoint(targetX, targetY, targetZ)
    local playerPos = Player.Position
    local dx = targetX - playerPos.X
    local dy = targetY - playerPos.Y
    local dz = targetZ - playerPos.Z
    return math.sqrt(dx * dx + dy * dy + dz * dz)
end
```

### Distance to Entity
```lua
-- Calculate distance to an entity
function GetDistanceToEntity(entity)
    if not entity or not entity.Position then
        return math.huge
    end
    
    local playerPos = Player.Position
    local entityPos = entity.Position
    local dx = entityPos.X - playerPos.X
    local dy = entityPos.Y - playerPos.Y
    local dz = entityPos.Z - playerPos.Z
    return math.sqrt(dx * dx + dy * dy + dz * dz)
end
```

### Distance Between Points
```lua
-- Calculate distance between two points
function GetDistanceBetweenPoints(x1, y1, z1, x2, y2, z2)
    local dx = x2 - x1
    local dy = y2 - y1
    local dz = z2 - z1
    return math.sqrt(dx * dx + dy * dy + dz * dz)
end
```

## Position Checking Functions

### Is At Position
```lua
-- Check if player is at a specific position (with tolerance)
function IsAtPosition(targetX, targetY, targetZ, tolerance)
    tolerance = tolerance or 2.0
    local distance = GetDistanceToPoint(targetX, targetY, targetZ)
    return distance <= tolerance
end
```

### Is Near Position
```lua
-- Check if player is near a specific position
function IsNearPosition(targetX, targetY, targetZ, maxDistance)
    maxDistance = maxDistance or 5.0
    local distance = GetDistanceToPoint(targetX, targetY, targetZ)
    return distance <= maxDistance
end
```

### Is Within Range
```lua
-- Check if player is within range of a position
function IsWithinRange(targetX, targetY, targetZ, minDistance, maxDistance)
    local distance = GetDistanceToPoint(targetX, targetY, targetZ)
    return distance >= minDistance and distance <= maxDistance
end
```

## Advanced Distance Functions

### Distance to Nearest Entity
```lua
-- Find distance to nearest entity of a specific type
function GetDistanceToNearestEntity(entityType, maxDistance)
    maxDistance = maxDistance or 50.0
    local nearestDistance = math.huge
    local nearestEntity = nil
    
    for entity in EntityList.GetEntities() do
        if entity.Type == entityType then
            local distance = GetDistanceToEntity(entity)
            if distance < nearestDistance and distance <= maxDistance then
                nearestDistance = distance
                nearestEntity = entity
            end
        end
    end
    
    return nearestDistance, nearestEntity
end
```

