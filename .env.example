# =============================================================================
# Environment Configuration
# =============================================================================
# This file is the SINGLE SOURCE OF TRUTH for all user-configurable variables.
# Copy this file to .env and fill in your values.
#
# IMPORTANT: Never commit .env to version control!
# =============================================================================

# Application Settings
NODE_ENV=development
PORT=3000

# Database Configuration
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=myapp
DATABASE_USER=
DATABASE_PASSWORD=

# API Keys
API_KEY=
API_SECRET=

# Logging
LOG_LEVEL=info
