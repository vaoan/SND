# =============================================================================
# Environment Configuration
# =============================================================================
# This file is the SINGLE SOURCE OF TRUTH for all user-configurable variables.
# Copy this file to .env and fill in your values.
#
# IMPORTANT: Never commit .env to version control!
# =============================================================================

# SND Plugin Configuration
# Path to the SomethingNeedDoing plugin config file where scripts will be synced
SND_CONFIG_PATH=Z:\Users\Heiner\Documents\Juegos\FFXIV\Profiles\Me\XIVLauncher\pluginConfigs\SomethingNeedDoing\ezSomethingNeedDoing.json

# Local Scripts Configuration
# Local folder containing Lua scripts (relative to project root)
LOCAL_SCRIPTS_ROOT=Playroom

# SND target folder name - scripts sync to/from this folder in SND
# Will be created if it doesn't exist
SND_TARGET_FOLDER=Synced
